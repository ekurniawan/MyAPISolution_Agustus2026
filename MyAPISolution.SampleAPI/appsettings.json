{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "SystemLogPath": "Logs/system-.txt",
    "ActionLogPath": "Logs/action-.txt",
    "Properties": {
      "Application": "MyAPISolution.SampleAPI"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.\\;Initial Catalog=LatihanDb;Integrated Security=True;TrustServerCertificate=True"
  },
  "AppSettings": {
    "Secret": "Ini adalah secret key yang digunakan di JWT token, anda dapat membuat key secara bebas"
  }
}
